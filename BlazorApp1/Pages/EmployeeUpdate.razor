@page "/updateprofile"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="d-flex align-items-center mb-4">
    <button class="btn back-btn-vibrant shadow-sm rounded-lg mr-3" @onclick="GoBack">
        <span class="oi oi-arrow-left" aria-hidden="true"></span> Back
    </button>

    <h3 class="d-flex align-items-center mb-0 ml-3">
        <span class="oi oi-pencil mr-2" style="font-size:1.4rem; color:#007bff;"></span>
        Update Profile
    </h3>
</div>

<div class="card shadow-lg p-4" style="max-width:400px; margin:auto; border-radius:12px;">
    <div class="mb-3">
        <input @bind="Username" placeholder="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <input @bind="Password" type="password" placeholder="Password" class="form-control" />
    </div>
    <button class="btn btn-primary w-100" @onclick="UpdateProfileAsync">Update</button>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert mt-2 @(IsError ? "alert-danger" : "alert-success")">
            @Message
        </div>
    }
</div>

<style>
    .back-btn-vibrant {
        background: linear-gradient(45deg, #A8E063 0%, #56AB2F 100%);
        color: #182848;
        border: none;
        font-weight: bold;
        transition: transform 0.2s, box-shadow 0.3s;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        padding: 0.5rem 1rem;
    }

        .back-btn-vibrant:hover {
            transform: translateY(-2px);
            background: linear-gradient(45deg, #74a83b 0%, #468c24 100%);
            box-shadow: 0 8px 15px rgba(24, 40, 72, 0.4);
        }
</style>

@code {
    private string Username;
    private string Password;
    private string Message;
    private bool IsError;

    private async Task UpdateProfileAsync()
    {
        Message = "";
        IsError = false;

        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            Message = "Please fill all fields.";
            IsError = true;
            return;
        }

        try
        {
            var dto = new UpdateProfileCommand
            {
                Username = Username,
                Password = Password
            };

            var response = await Http.PutAsJsonAsync("/api/Employee/Update-Profile", dto);

            if (response.IsSuccessStatusCode)
            {
                Message = "Profile updated successfully!";
                IsError = false;
                StateHasChanged();
                await Task.Delay(1500);
                Navigation.NavigateTo("/employeepanel");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = string.IsNullOrEmpty(error)
                    ? $"Failed to update profile. Status: {response.StatusCode}"
                    : $"Failed: {error}";
                IsError = true;
            }
        }
        catch (Exception ex)
        {
            Message = $"Error: {ex.Message}";
            IsError = true;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/employeepanel");
    }

    // DTO class
    public class UpdateProfileCommand
    {
        public string Username { get; set; }
        public string Password { get; set; }
    }
}
